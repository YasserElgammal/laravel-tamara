{
    "name": "yasser-elgammal/laravel-tamara",
    "description": "A strongly typed Tamara payment integration for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {"YasserElgammal\\Tamara\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"YasserElgammal\\Tamara\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["YasserElgammal\\Tamara\\TamaraServiceProvider"],
            "aliases": {"Tamara": "YasserElgammal\\Tamara\\Facades\\Tamara"}
        }
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
